# Copy this file to .env and fill in your values. NEVER commit the real .env.
# Get api_id / api_hash from https://my.telegram.org -> API development tools

TG_API_ID=
TG_API_HASH=

# Your phone number in international format, e.g. +923001234567
# Needed for the non-interactive login (login.py).
TG_PHONE=

# Only if you have Two-Step Verification (2FA) enabled on Telegram.
TG_PASSWORD=

# The group/channel with Bobby FX's signals.
# Use the @username, a t.me link, or a numeric -100... chat id.
TG_CHAT=https://t.me/ChartCraftAdminFx

# Optional: only keep messages from Bobby FX. Put his @username (without @)
# or numeric user id. Leave EMPTY to capture every message in the chat
# (recommended for the first run so we can find his exact handle).
TG_SENDER=

# How many months of history to pull.
TG_MONTHS_BACK=6

# Session file name (cached login; created on first run).
TG_SESSION=signals

# Free key for 1-min XAUUSD price data: https://twelvedata.com/register
TWELVEDATA_KEY=
